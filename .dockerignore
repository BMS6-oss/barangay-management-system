# =====================================================================
# Docker Ignore Configuration for Barangay Management System (BMS)
# Defense-in-Depth Container Image Secret & Data Protection
# =====================================================================

# 1. Version control & IDEs
.git
.gitignore
.dockerignore
.github/
.vscode/
.idea/
.githooks/

# 2. Environment & secrets (NEVER copy into container image)
.env
.env.*
.env.local
.env.development
.env.staging
.env.production
!.env.example

# 3. Secret directories, credentials, and private keys
secrets/
credentials/
*.credential*
*service-account*.json
*.pem
*.key
*.p12
*.pfx
*.pkcs12
*.kdbx
*.crt
*.cert
*.p8
id_rsa*
id_ecdsa*
id_ed25519*

# 4. Logs & temp files
*.log
bms_server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
scratch/
tmp/
temp/

# 5. Local databases, backups & personal data dumps (production uses mounted volume or initializes clean schema)
*.sqlite
*.sqlite3
*.sqlite3*
*.db
bms.db
bms.*.sqlite3
*resident*.csv
*residents*.csv
*voter*.csv
*export*.csv
*.dump
*.sql
*.bak
*backup*
*.tar.gz
*.tar
*.7z

# 6. Windows-specific launcher scripts
*.bat
*.vbs

# 7. Test and development scripts
test_*.py
test_*.js
acceptance_test.py
check_users.py
fix_passwords.py
inspect_db.py
inspect_sections.py
reset.py
verify_logins.py
_inspect_db*

# 8. Temporary drafts
BMS_NEW*.html
BMS_NEW*.txt
