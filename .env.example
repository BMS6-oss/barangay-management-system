# =====================================================================
# Barangay Management System (BMS) Environment Configuration Template
# Copy this file to .env for local overrides. NEVER commit .env to Git!
# =====================================================================

# ---------------------------------------------------------------------
# 1. NETWORK & SERVER CONFIGURATION
# ---------------------------------------------------------------------
# Host interface to bind. Use 0.0.0.0 for Docker / cloud deployments.
BMS_HOST=0.0.0.0

# Port to listen on. Render automatically sets PORT (defaults to 8000 locally).
PORT=8000
# BMS_PORT=8000

# Public application URL (e.g. https://your-bms.onrender.com)
# APP_URL=https://your-bms.onrender.com

# Comma-separated browser origins allowed to call the API via CORS.
# For same-origin deployments, this is optional.
BMS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Public Frontend API Base URL (leave empty for same-origin production deployment)
# API_BASE_URL=

# Browser auto-opening (false in Docker/Render/cloud, true for local Windows desktop)
BMS_AUTO_OPEN_BROWSER=false

# Require HTTPS (enables HSTS header; set true in production behind HTTPS)
BMS_REQUIRE_HTTPS=false

# ---------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ---------------------------------------------------------------------
# Path to SQLite database file.
# On Render with Persistent Disk mounted at /data, set:
# BMS_DATABASE_PATH=/data/bms.sqlite3
# Defaults to bms.sqlite3 in project root if not set.
BMS_DATABASE_PATH=bms.sqlite3

# Optional: Reserved for external PostgreSQL connection string if migrated
# DATABASE_URL=postgresql://user:password@host:5432/bms

# ---------------------------------------------------------------------
# 3. SECURITY & RATE LIMITING (Server-Side)
# ---------------------------------------------------------------------
TOKEN_TTL_SECONDS=28800
MAX_BODY_BYTES=10485760
BMS_RATE_LIMIT_ENABLED=true
BMS_LOGIN_RATE_LIMIT=10
BMS_REGISTER_RATE_LIMIT=5
BMS_WRITE_RATE_LIMIT=120
BMS_RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 CREDENTIALS (Server-Only Secrets, Optional)
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-bms.onrender.com/api/google/callback
